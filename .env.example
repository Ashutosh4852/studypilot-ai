# StudyPilot AI - Environment Configuration
# All sensitive API keys are kept strictly on the server-side

# Optional: Google Gemini API Key for AI PDF Summarization, Q&A, and Image Generation
# If not provided, StudyPilot AI uses high-performance built-in offline heuristic engines
GEMINI_API_KEY=

# Optional: OpenAI API Key (alternative AI provider)
OPENAI_API_KEY=

# Next.js Public Configuration
NEXT_PUBLIC_APP_NAME="StudyPilot AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
